{
  "title": "AI Code Reviewer",
  "uid": "ai-code-reviewer",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Precision",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "reviewer_quality_precision",
          "legendFormat": "{{project}} {{stage}} {{prompt_version}} {{model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fabrication rate",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "reviewer_quality_fabrication_rate",
          "legendFormat": "{{project}} {{stage}} {{prompt_version}} {{model}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Coverage",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "reviewer_quality_coverage",
          "legendFormat": "{{project}} {{stage}} {{prompt_version}} {{model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Model latency (ms)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "reviewer_quality_latency_ms",
          "legendFormat": "{{project}} {{stage}} {{prompt_version}} {{model}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Review cost",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "reviewer_quality_cost",
          "legendFormat": "{{project}} {{stage}} {{prompt_version}} {{model}}"
        }
      ]
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
