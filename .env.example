# Local dev only. Copy to .env and replace password and tokens before startup.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+asyncpg://reviewer:replace-with-a-random-password@postgres/reviewer
REDIS_URL=redis://redis:6379/0
GITLAB_BASE_URL=https://gitlab.example.invalid
GITLAB_TOKEN=
# JSON array of GitLab numeric project IDs to onboard (including manual-only use).
PROJECT_IDS=[]
# Optional JSON mapping of project IDs to distinct webhook secrets.
# These IDs are also onboarded for compatibility; leave empty for manual-only use.
WEBHOOK_SECRETS={}
# Bearer token for admin and metrics endpoints. Empty disables access.
ADMIN_TOKEN=
MILESTONE=M9

# Read-only repository token, separate from GitLab publication token.
GIT_READ_TOKEN=
JIRA_BASE_URL=
JIRA_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
# Internal OpenAI-compatible gateway; enter approved model IDs and context limit.
GATEWAY_BASE_URL=
GATEWAY_KEY=
MODEL_STRONG=
MODEL_FAST=
MODEL_VERIFIER=
MODEL_CONTEXT_TOKENS=200000
REPO_CACHE=/var/lib/reviewer/repos
AUDIT_PATH=/var/lib/reviewer/audit
AUDIT_RETENTION_DAYS=30
CONFIG_PATH=/app/config/projects.json
# Enable only with the optional sandbox Docker daemon configuration.
STATIC_ENABLED=false
OTLP_ENDPOINT=
# Optional cost per million tokens by exact gateway model ID. Missing prices
# are reported as unknown, not as zero-cost calls.
MODEL_PRICES={}
# Optional internal S3-compatible audit store. Otherwise use the local volume.
# Configure a retention lifecycle for the review-audit/ prefix in this bucket.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
